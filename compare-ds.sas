/****************************************************************************************************/
/*                                                                                                  */
/* Descrtption:  Compare 2 datasets using PROC COMPARE, create the output containing differences    */
/*                 from the PROC COMPARE, and optionnally creates the datasets containing           */
/*                 the records present in one dataset but not the other one, and datasets containing*/
/*                 the differences of some specific variables                                       */
/*                                                                                                  */
/*      Author:  Kevin Francois                                                                     */
/*                                                                                                  */
/*        Date:  19JUL2023                                                                          */
/*                                                                                                  */
/*  Parameters:  ds_left= input dataset that will be used as "BASE" dataset in the PROC COMPARE     */
/*               ds_right= input dataset that will be used as "COMP" dataset in the PROC COMPARE    */
/*               id_keys= populate with list variables used as ID keys of the PROC COMPARE,         */
/*                             e.g. "USUBJID PARAM AVISITN AVISIT". If left blank, PROC COMPARE     */
/*                             will be run without ID statement (default is null)                   */
/*               criterion= put the value to fullfill CRITERION option, METHOD will then be set on  */
/*                             ABSOLUTE (default is null)                                           */
/*               more_ds= put Y to get the datasets containing the records present in one dataset   */
/*                             but not the other one, based on ID keys (default is null)            */
/*               dup_ds= put Y to get a subselection of each input dataset (ending with _DUP)       */
/*                             containing the duplicated records ONLY, based on ID keys (default=Y) */
/*               focus= By default, the parater is set to _ALL_ to automatically run the option on  */
/*                             all variables with at least one difference. Otherwise, populate with */
/*                             the variables for which you want to get specific datasets containing */
/*                             the differences.                                                     */
/*                             The dataset &ds_left2._YOURVARIABLE will be a subset of the dataset  */
/*                             generated by the PROC COMPARE, on the records containing differences */
/*                             for this variable only.                                              */
/*                             The dataset &ds_left2._YOURVARIABLE_t will be the transposed version */
/*                             of the former dataset and will be printed with the same format than  */
/*                             the original print of the PROC COMPARE.                              */
/*                             Unlike the original print of the PROC COMPARE, those prints will     */
/*                             contain all ID variables and the values won't be truncated. You can  */
/*                             also set the parameter to null in order to have no dataset of        */
/*                             this type and only the original print of the PROC COMPARE            */
/*               maxprint= put the number of records you would like to get, at most, in the print   */
/*                             of the differences for each concerned variable (default=200)         */
/*               compbl= put Y to apply COMPBL function to all character variables, i.e. two or more*/
/*                             consecutive spaces/blanks become a single space/blank                */
/*                                                                              (default is null)   */
/*               upcase= put Y to apply UPCASE function to all character variables (default is null)*/
/*               compress= put Y to apply COMPRESS function to all character variables,             */
/*                             i.e. remove the listed characters (default is null)                  */
/*               cpr_list= list of characters used by COMPRESS function when &compress=Y,           */
/*                             i.e. list of characters removed from character variables             */
/*                             when &compress=Y (default is space/blank character)                  */
/*               strip= put Y to apply STRIP function to all character variables (default is null)  */
/*               options_left= put DATA options you want to apply to the ds_left dataset,           */
/*                             e.g. %STR((WHERE=(paramcd="ALP"))) (default is null)                 */
/*               options_right= put DATA options you want to apply to the ds_right dataset,         */
/*                             e.g. %STR((WHERE=(paramcd="ALP"))) (default is null)                 */
/*               manual_comp_opt= put the PROC COMPARE options you want to add to the existing ones */
/*                                                                                                  */
/*     Example:  %compare_ds (ds_left=derived.adae, ds_right=qcder.qc_adae,                         */
/*                            id_keys=studyid usubjid astdt aeterm aendt aeloc,                     */
/*                            criterion=0.0001, more_ds=Y, focus=trtemfl aser, maxprint=200);       */
/*                                                                                                  */
/* Software and version: SAS Version 9.4                                                            */
/****************************************************************************************************/

%MACRO compare_ds (ds_left=, ds_right=, id_keys=, criterion=,
                    more_ds=, dup_ds=Y, focus=_ALL_, maxprint=200,
                    compbl=, upcase=, compress=, cpr_list=%STR( ), strip=,
                    options_left=, options_right=, 
                    manual_comp_opt=,
                    debug=) /SECURE;

   %IF %SYSFUNC(FINDC(%STR(&ds_left.), %STR(.)))>0 %THEN %DO;
      %LET ds_left2=%SUBSTR(%SCAN(%STR(&ds_left.), 2, %STR(.)), 1, %SYSFUNC(MIN(%LENGTH(%SCAN(%STR(&ds_left.), 2, %STR(.))), 17)))_cpl;
   %END;
   %ELSE %DO;
      %LET ds_left2=%SUBSTR(&ds_left., 1, %SYSFUNC(MIN(%LENGTH(&ds_left.), 17)))_cpl;
   %END;

   %IF %SYSFUNC(FINDC(%STR(&ds_right.), %STR(.)))>0 %THEN %DO;
      %LET ds_right2=%SUBSTR(%SCAN(%STR(&ds_right.), 2, %STR(.)), 1, %SYSFUNC(MIN(%LENGTH(%SCAN(%STR(&ds_right.), 2, %STR(.))), 17)))_cpr;
   %END;
   %ELSE %DO;
      %LET ds_right2=%SUBSTR(&ds_right., 1, %SYSFUNC(MIN(%LENGTH(&ds_right.), 17)))_cpr;
   %END;
   
   %LET id_keys2=%SYSFUNC(TRANWRD(%STR(&id_keys.), %STR( ), %STR(, )));
   %LET id_keys3=%SYSFUNC(TRANWRD(%STR(&id_keys.), %STR( ), %STR(, a.)));
   
   %IF "&id_keys."^="" %THEN %DO vs=1 %TO %SYSFUNC(COUNTW(%STR(&id_keys.), %STR( ))); 
      %IF &vs.=1 %THEN %DO; %LET id_keys_vs=x.%SCAN(%STR(&id_keys.), 1, %STR( ))=y.%SCAN(%STR(&id_keys.), 1, %STR( )); %END;
      %ELSE %DO; %LET id_keys_vs=&id_keys_vs. AND x.%SCAN(%STR(&id_keys.), &vs., %STR( ))=y.%SCAN(%STR(&id_keys.), &vs., %STR( )); %END;
   %END;
   
   PROC CONTENTS DATA=&ds_left. OUT=&ds_left2._ct NOPRINT; RUN;
   PROC CONTENTS DATA=&ds_right. OUT=&ds_right2._ct NOPRINT; RUN;
   
   PROC SQL NOPRINT;
      SELECT DISTINCT MAX(modate) FORMAT=BEST., COMPRESS(memlabel, "", "P") INTO :%STR(&ds_left2._modate) TRIMMED, :%STR(&ds_left2._label) TRIMMED FROM %STR(&ds_left2._ct);
      SELECT DISTINCT MAX(modate) FORMAT=BEST., COMPRESS(memlabel, "", "P") INTO :%STR(&ds_right2._modate) TRIMMED, :%STR(&ds_right2._label) TRIMMED FROM %STR(&ds_right2._ct);
   QUIT;
   
   %IF %UPCASE(%SUBSTR(%STR(&syshostname),1,3))=RDU %THEN %DO;
      %LET timez='AMERICA/FORT_WAYNE' (UTC %sysfunc(putn(%eval(%SYSFUNC(TZONEOFF(AMERICA/FORT_WAYNE))/3600),z3.)):00);
   %END;
   %ELSE %IF %UPCASE(%SUBSTR(%STR(&syshostname),1,3))=BRU %THEN %DO;
      %LET timez='EUROPE/BRUSSELS' (UTC +%sysfunc(putn(%eval(%SYSFUNC(TZONEOFF(EUROPE/BRUSSELS))/3600),z2.)):00);
   %END;
   
   %LET poschar=%EVAL(%SYSFUNC(MAX(%LENGTH(%STR(&ds_left.)), %LENGTH(%STR(&ds_right.))))+4);
   
   PROC SQL NOPRINT;
      SELECT COUNT(*) INTO :rtf_cnt TRIMMED FROM sashelp.vdest WHERE UPCASE(STRIP(destination))="RTF";
   QUIT;

   %IF &rtf_cnt.>=1 %THEN %DO;
      ODS TEXT="%STR(&ds_left.  - Last Modification Date: )%SYSFUNC(PUTN(&&&ds_left2._modate., DATETIME19.))%STR( [&timez.])  - Label: %STR(&&&ds_left2._label.)";
      ODS TEXT="%STR(&ds_right.  - Last Modification Date: )%SYSFUNC(PUTN(&&&ds_right2._modate., DATETIME19.))%STR( [&timez.])  - Label: %STR(&&&ds_right2._label.)";
      
      %IF &&&ds_left2._modate.>=&&&ds_right2._modate. %THEN %DO;
         ODS TEXT=" ";
         ODS TEXT="/!\ Your 'BASE' dataset has been modified after your 'COMP' dataset!";
      %END;
      ODS TEXT=" ";
      ODS TEXT=" ";
   %END;
   
   DATA _NULL_;
      modatel=PUT(%STR(&&&ds_left2._modate.), DATETIME19.);
      modater=PUT(%STR(&&&ds_right2._modate.), DATETIME19.);
      labell="%STR(&&&ds_left2._label.)";
      labelr="%STR(&&&ds_right2._label.)";
      PUT "NOT" "E: *USER* Comparison of the BASE dataset: &ds_left. with the COMP dataset: &ds_right.";
      PUT " ";
      PUT "NOT" "E: *USER* &ds_left." @%EVAL(&poschar.+13) "   Last Modification Date: " modatel " [&timez.]    Label: " labell;
      PUT "NOT" "E: *USER* &ds_right." @%EVAL(&poschar.+13) "   Last Modification Date: " modater " [&timez.]    Label: " labelr;
      IF &&&ds_left2._modate.>=&&&ds_right2._modate. THEN DO;
         PUT " ";
         PUT "WAR" "NING: *USER* Your 'BASE' dataset has been modified after your 'COMP' dataset!";
      END;
   RUN;
   
   DATA &ds_left2._;
      SET &ds_left. &options_left.;
      
      ARRAY _char {*} _CHARACTER_;
      
      %IF %UPCASE(&compress.)=Y OR %UPCASE(&compbl.)=Y OR %UPCASE(&upcase.)=Y OR %UPCASE(&strip.)=Y %THEN %DO;
         DO i=1 TO DIM(_char);
            %IF %UPCASE(&compress.)=Y %THEN %DO; _char[i]=COMPRESS(_char[i],"&cpr_list."); %END;
            %IF %UPCASE(&compbl.)=Y %THEN %DO; _char[i]=COMPBL(STRIP(_char[i])); %END;
            %IF %UPCASE(&upcase.)=Y %THEN %DO; _char[i]=UPCASE(_char[i]); %END;
            %IF %UPCASE(&strip.)=Y %THEN %DO; _char[i]=STRIP(_char[i]); %END;
         END;
         drop i;
      %END;
   RUN;
   
   DATA &ds_right2._;
      SET &ds_right. &options_right.;
      
      ARRAY _char {*} _CHARACTER_;
      
      %IF %UPCASE(&compress.)=Y OR %UPCASE(&compbl.)=Y OR %UPCASE(&upcase.)=Y OR %UPCASE(&strip.)=Y %THEN %DO;
         DO i=1 TO DIM(_char);
            %IF %UPCASE(&compress.)=Y %THEN %DO; _char[i]=COMPRESS(_char[i],"&cpr_list."); %END;
            %IF %UPCASE(&compbl.)=Y %THEN %DO; _char[i]=COMPBL(STRIP(_char[i])); %END;
            %IF %UPCASE(&upcase.)=Y %THEN %DO; _char[i]=UPCASE(_char[i]); %END;
            %IF %UPCASE(&strip.)=Y %THEN %DO; _char[i]=STRIP(_char[i]); %END;
         END;
         drop i;
      %END;
   RUN;

   %IF "&id_keys."^="" %THEN %DO;
      PROC SORT DATA=&ds_left2._ OUT=&ds_left2. (LABEL="%STR(&&&ds_left2._label.)");
         BY &id_keys.;
      RUN;
      
      PROC SORT DATA=&ds_right2._ OUT=&ds_right2. (LABEL="%STR(&&&ds_right2._label.)");
         BY &id_keys.;
      RUN;
      
      %IF &dup_ds.=Y %THEN %DO;
         PROC SQL NOPRINT;
            CREATE TABLE &ds_left2._DUP AS SELECT
            *
            FROM &ds_left2.
            GROUP BY &id_keys2.
            HAVING COUNT(*)>1
            
            ORDER BY &id_keys2.
            ;
            
            CREATE TABLE &ds_right2._DUP AS SELECT
            *
            FROM &ds_right2.
            GROUP BY &id_keys2.
            HAVING COUNT(*)>1
            
            ORDER BY &id_keys2.
            ;
         QUIT;
      %END;
   %END;
   %ELSE %DO;
      DATA &ds_left2. (LABEL="%STR(&&&ds_left2._label.)"); SET &ds_left2._; RUN;
      DATA &ds_right2. (LABEL="%STR(&&&ds_right2._label.)"); SET &ds_right2._; RUN;
   %END;
   
   %IF "&focus."^="" %THEN %DO; ODS OUTPUT CompareSummary=cs; %END;
   PROC COMPARE BASE=&ds_left2. COMP=&ds_right2. MAXPRINT=&maxprint.
                  %IF "&criterion."^="" %THEN %DO; CRITERION=&criterion. METHOD=ABSOLUTE %END;
                  %IF %UPCASE(&focus.)=_ALL_ %THEN %DO; NOVALUES %END;
              %IF %UPCASE(&var_eq_list.)=Y %THEN %DO; LISTEQUALVAR %END;
                  LISTALL NOTE OUTBASE OUTCOMP OUTDIF OUTNOEQUAL &manual_comp_opt. OUT=&ds_left2._Dif;
      %IF "&id_keys."^="" %THEN %DO;
         ID &id_keys.;
      %END;
   RUN;
   
   %IF "&id_keys."^="" %THEN %DO;
      PROC CONTENTS DATA=&ds_left2._Dif OUT=&ds_left2._Dif_ct NOPRINT; RUN;
      
      PROC SQL NOPRINT;
         SELECT name, type INTO :id_key_list SEPARATED BY " ", :id_key_type_list SEPARATED BY " " FROM &ds_left2._Dif_ct
            WHERE UPCASE(STRIP(name)) IN (%DO id=1 %TO %SYSFUNC(COUNTW(%STR(&id_keys.), %STR( ))); "%UPCASE(%SCAN(%STR(&id_keys.), &id., %STR( )))" %END;)
         ;
      QUIT;
   %END;
   
   DATA &ds_left2._Diff;
      SET &ds_left2._Dif;
      
      %IF "&id_keys."^="" %THEN %DO id=1 %TO %SYSFUNC(COUNTW(%STR(&id_keys.), %STR( ))); 
         %LET id_key=%SCAN(%STR(&id_key_list.), &id., %STR( ));
         %LET id_key_type=%SCAN(%STR(&id_key_type_list.), &id., %STR( ));
         
         %IF &id_key_type.=2 %THEN %DO;
            &id_key.=COMPRESS(&id_key., '00'x);
         %END;
      %END;
   RUN;
   
   
   %IF "&id_keys."^="" & %UPCASE(&more_ds.)=Y %THEN %DO;
      PROC SQL NOPRINT;
         CREATE TABLE %UNQUOTE(more_&ds_left2.) (WHERE=(to_del^="Y")) AS SELECT 
         x.*, y.to_del
         FROM &ds_left2. x
          LEFT JOIN (SELECT DISTINCT &id_keys2., "Y" AS to_del FROM &ds_right2.) y
           ON &id_keys_vs.
         ;
         ALTER TABLE %UNQUOTE(more_&ds_left2.) DROP to_del
         ;
         CREATE TABLE %UNQUOTE(more_&ds_right2.) (WHERE=(to_del^="Y")) AS SELECT
         x.*, y.to_del
         FROM &ds_right2. x
          LEFT JOIN (SELECT DISTINCT &id_keys2., "Y" AS to_del FROM &ds_left2.) y 
           ON &id_keys_vs.
         ;
         ALTER TABLE %UNQUOTE(more_&ds_right2.) DROP to_del
         ;
      QUIT;
   %END;
   %ELSE %IF %UPCASE(&more_ds.)=Y %THEN %DO;
      %PUT %STR(WAR)%STR(NING: *USER* Please populate id_keys parameter to get the datasets with containing the records present in one dataset but not the other one.);
   %END;
   
   %LET difftest=;
   
   %IF "&focus."^="" %THEN %DO;
      PROC SQL NOPRINT;
         SELECT DISTINCT MAX(CASE WHEN COMPBL(UPCASE(STRIP(batch))) IN ("VARIABLES WITH UNEQUAL VALUES", "ALL VARIABLES COMPARED HAVE UNEQUAL VALUES") THEN "Y" ELSE "N" END) INTO :difftest TRIMMED FROM cs;
      QUIT;
   %END;
   
   %IF "&focus."^="" & %UPCASE(&difftest.)=Y %THEN %DO;
      %IF %UPCASE(&focus.)=_ALL_ %THEN %DO;
         DATA cs2;
            SET cs;
            LENGTH vars $200.;
            RETAIN uneqfl;
         
            IF COMPBL(UPCASE(STRIP(batch))) IN ("VARIABLES WITH UNEQUAL VALUES", "ALL VARIABLES COMPARED HAVE UNEQUAL VALUES") THEN uneqfl="Y";
            
            IF UPCASE(STRIP(uneqfl))="Y" & UPCASE(STRIP(type))="D" & STRIP(batch)^="" THEN vars=UPCASE(STRIP(SCAN(batch, 1, " ")));
         RUN;
         
         PROC SQL NOPRINT;
            SELECT vars INTO :vdiff_list SEPARATED BY " " FROM cs2 WHERE STRIP(vars)^="";
         QUIT;
      %END;
      %ELSE %DO; %LET vdiff_list=&focus.; %END;
     
     PROC CONTENTS DATA=&ds_left2._Diff OUT=&ds_left2._Diff_ct NOPRINT; RUN;
   
      %DO nf=1 %TO %SYSFUNC(COUNTW(%STR(&vdiff_list.)));
         %LET focus_var=%SCAN(%STR(&vdiff_list.), &nf.);
       
       PROC SQL NOPRINT; SELECT DISTINCT CASE WHEN type=1 THEN "NUM" ELSE "CHAR" END INTO :&focus_var._type FROM &ds_left2._Diff_ct (WHERE=(UPCASE(STRIP(name))="%UPCASE(&focus_var.)")); QUIT;
      
         PROC SQL NOPRINT;
            CREATE TABLE COMP_VAR_&focus_var. AS SELECT
            *
            FROM &ds_left2._Diff
            GROUP BY %IF "&id_keys."^="" %THEN %DO; &id_keys2. %END; %ELSE %DO; _OBS_ %END;
             HAVING MAX(COMPRESS(STRIP(CASE WHEN UPCASE(STRIP(_type_))="DIF" THEN STRIP(%IF &&&focus_var._type.=NUM %THEN %DO; PUT(&focus_var., BEST.) %END; %ELSE %DO; &focus_var. %END;) ELSE "" END), ".")) NOT IN ("" "E")
                      %IF &&&focus_var._type.=NUM %THEN %DO; 
                       OR ( MAX(COMPRESS(STRIP(CASE WHEN UPCASE(STRIP(_type_))="DIF" THEN STRIP(PUT(&focus_var., BEST.)) ELSE "" END), "."))=""
                           AND MAX(STRIP(CASE WHEN UPCASE(STRIP(_type_))^="DIF" THEN STRIP(PUT(&focus_var., BEST.)) ELSE "" END))^=""
                          )
                      %END;

            
            ORDER BY _obs_, _type_
            ;
         QUIT;
         
       %IF "&id_keys."^="" %THEN %DO; 
            %LET id_keys_vs_b=%SYSFUNC(TRANWRD(%SYSFUNC(TRANWRD(%STR(&id_keys_vs.), %STR(x.), %STR(a.))), %STR(y.), %STR(b.)));
            %LET id_keys_vs_c=%SYSFUNC(TRANWRD(%SYSFUNC(TRANWRD(%STR(&id_keys_vs.), %STR(x.), %STR(a.))), %STR(y.), %STR(c.)));
       %END;

         PROC SQL NOPRINT;
            CREATE TABLE COMP_VAR_&focus_var._t AS SELECT
            a._OBS_
            %IF "&id_keys."^="" %THEN %DO; , a.&id_keys3. %END;
            , a.&focus_var. AS BASE
            , b.&focus_var. AS COMPARE
            , c.&focus_var. AS DIF
            FROM COMP_VAR_&focus_var. (WHERE=(UPCASE(STRIP(_TYPE_))="BASE")) a
             INNER JOIN COMP_VAR_&focus_var. (WHERE=(UPCASE(STRIP(_TYPE_))="COMPARE")) b
              ON %IF "&id_keys."^="" %THEN %DO; &id_keys_vs_b. %END; %ELSE %DO; a._OBS_=b._OBS_ %END;
             INNER JOIN COMP_VAR_&focus_var. (WHERE=(UPCASE(STRIP(_TYPE_))="DIF")) c
              ON %IF "&id_keys."^="" %THEN %DO; &id_keys_vs_c. %END; %ELSE %DO; a._OBS_=c._OBS_ %END;
              
            ORDER BY %IF "&id_keys."^="" %THEN %DO; &id_keys2., %END; _OBS_
            ;
         QUIT;
         
         DATA COMP_VAR_&focus_var._;
            SET COMP_VAR_&focus_var._t;
            
            IF _N_<=&maxprint.;
            
            KEEP _OBS_ %IF "&id_keys."^="" %THEN %DO; &id_keys. %END; base compare dif;
            LABEL base="&ds_left." compare="&ds_right.";
         RUN;
         
         PROC REPORT DATA=COMP_VAR_&focus_var._ NOWD NOCENTER MISSING HEADSKIP HEADLINE SPACING=0 SPLIT="!" WRAP
                  STYLE(report)={rules=rows frame=hsides bodysize=100% contentsize=100% outputwidth=100%}
                  STYLE(HEADER)={FRAME=HSIDES JUST=C CELLSPACING=0 BODYSIZE=100% CONTENTSIZE=100% font_size=9pt}
                  STYLE(column)={frame=hsides cellspacing=0 bodysize=100% contentsize=100% font_size=8pt};
                  
            COLUMNS ("&focus_var." _OBS_ 
                        %IF "&id_keys."^="" %THEN %DO;
                           %DO nid=1 %TO %SYSFUNC(COUNTW(%STR(&id_keys.)));
                              %LET idvar=%SCAN(%STR(&id_keys.), &nid., %STR( ));
                              ("%UPCASE(&idvar.)" &idvar.)
                           %END;
                        %END;
                        ("Comparison" base compare dif)
                     );
            
            DEFINE _OBS_ / DISPLAY STYLE(column)=[WIDTH=6.75% just=l asis=on background=lightgrey] FLOW "Observ.!Number";
            %IF "&id_keys."^="" %THEN %DO;
               %DO nid=1 %TO %SYSFUNC(COUNTW(%STR(&id_keys.)));
                  %LET idvar=%SCAN(%STR(&id_keys.), &nid., %STR( ));
                  DEFINE &idvar. / DISPLAY FLOW;
               %END;
            %END;
            DEFINE base / DISPLAY STYLE(column)=[just=l asis=on background=cxDEEAF6] FLOW;
            DEFINE compare / DISPLAY STYLE(column)=[just=l asis=on background=cxE2EFD9] FLOW;
            DEFINE dif / DISPLAY STYLE(column)=[just=l asis=on background=cxFBE4D5] FLOW "Difference";
         RUN;
         
         PROC DATASETS LIB=work NOLIST;
            DELETE COMP_VAR_&focus_var._;
         QUIT;
      %END;
         
      %IF %UPCASE(&debug.)^=Y %THEN %DO;
         PROC DATASETS LIB=work NOLIST;
            DELETE &ds_left2._ &ds_right2._ cs cs2 &ds_left2._ct &ds_right2._ct &ds_left2._Diff_ct &ds_left2._Dif &ds_left2._Dif_ct;
         QUIT;
      %END;
      
   %END;

%MEND compare_ds;



